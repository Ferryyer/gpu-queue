<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The existing desktop preview is unsandboxed for local PTY and SSH.
       file_picker still requires this explicit user-selected-file capability.
       Do not carry Developer-ID-only iCloud or keychain groups into ad-hoc signing. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
